# Public HTTPS origin used by ChatGPT and OAuth metadata, without a trailing slash.
PUBLIC_BASE_URL=https://eats-mcp.example.com

# Host-only port forwarded to container port 3000 for the existing tunnel.
MCP_BIND_PORT=3000
MCP_AUTH_MODE=oauth
LOG_LEVEL=info

# Compose reads the secret contents from these ignored host files.
# The files must contain only the raw cookie header and OAuth password respectively.
YANDEX_EATS_COOKIE_SECRET_FILE=./secrets/yandex_eats_cookie
MCP_OAUTH_PASSWORD_SECRET_FILE=./secrets/mcp_oauth_password
ORDER_NOTIFY_TELEGRAM_TOKEN_SECRET_FILE=./secrets/order_notify_telegram_token
ORDER_NOTIFY_TELEGRAM_CHAT_ID_SECRET_FILE=./secrets/order_notify_telegram_chat_id

YANDEX_EATS_BASE_URL=https://eats.yandex.com
YANDEX_EATS_LOCALE=ru
YANDEX_EATS_PLATFORM=desktop_web
YANDEX_EATS_APP_VERSION=18.43.3
YANDEX_EATS_LATITUDE=
YANDEX_EATS_LONGITUDE=
YANDEX_EATS_CITY=Yerevan
YANDEX_EATS_ADDRESS_LABEL=home
YANDEX_EATS_TIMEOUT_MS=15000
YANDEX_EATS_MAX_SEARCH_PLACES=10
YANDEX_EATS_MAX_ITEMS_PER_PLACE=5

# Keep cart mutations disabled until the opt-in live add/reconcile/remove check is prepared.
# Checkout and place_order are not implemented regardless of this flag.
YANDEX_EATS_ENABLE_MUTATIONS=false

# Server-directed, read-only polling with a persistent cursor event journal.
YANDEX_EATS_ENABLE_ORDER_MONITORING=false
YANDEX_EATS_ORDER_POLL_MIN_MS=2000
YANDEX_EATS_ORDER_POLL_MAX_MS=60000
YANDEX_EATS_ORDER_ERROR_BACKOFF_MAX_MS=120000
YANDEX_EATS_ORDER_EVENT_RETENTION_DAYS=30
YANDEX_EATS_ORDER_EVENT_MAX_COUNT=1000

# Use telegram only after creating both ignored secret files documented in README.
ORDER_NOTIFY_PROVIDER=none
